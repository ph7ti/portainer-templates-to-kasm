# Kasm
KASM_URL=https://kasm.example.com
KASM_API_KEY=changeme
KASM_API_KEY_SECRET=changeme
# auto detects /api/public/get_kasms (Kasm <= 1.19.0) or /api/session/sessions (newer)
KASM_API_MODE=auto
# Use false when Kasm uses an internal CA (this deployment); prefer installing
# the CA in production.
KASM_VERIFY_TLS=false
KASM_REQUEST_TIMEOUT=20

# Lifecycle
POLL_INTERVAL=5
RETRY_INTERVAL=30

# Docker
DOCKER_NETWORK=kasm_default_network
DOCKER_DISCOVER_NETWORK=true
PULL_IMAGES=true
DOCKER_TIMEOUT=180
VOLUME_PREFIX=kasm-teste-vol-
DRY_RUN=false

# Paths
MANIFEST_PATH=registry/backend_manifest.json
STATE_PATH=/var/lib/kasm-orchestrator/state.json
LOG_LEVEL=INFO
