{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/kasmtech/workspaces_registry_template/1.1/workspace.schema.json",
  "title": "Kasm Workspaces Registry Entry (schema 1.1)",
  "description": "Derived from the schema table published in kasmtech/workspaces_registry_template (branch 1.1) and the Kasm 1.17/1.19 Protected Web Apps documentation. It validates the entries generated by this repository; it is not an official Kasm-published JSON Schema.",
  "type": "object",
  "required": [
    "friendly_name",
    "description",
    "image_src",
    "architecture",
    "compatibility"
  ],
  "additionalProperties": false,
  "properties": {
    "friendly_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "image_src": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "architecture": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["amd64", "arm64"]
      }
    },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "image", "uncompressed_size_mb"],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "uncompressed_size_mb": {
            "type": "integer",
            "minimum": 0
          },
          "available_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "docker_registry": {
      "type": "string",
      "minLength": 1
    },
    "run_config": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "shm_size": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "exec_config": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {
      "type": "string"
    },
    "cores": {
      "type": "integer",
      "minimum": 1
    },
    "memory": {
      "type": "integer",
      "minimum": 1
    },
    "gpu_count": {
      "type": "integer",
      "minimum": 0
    },
    "cpu_allocation_method": {
      "type": "string",
      "enum": ["Inherit", "Quotas", "Shares"]
    }
  }
}
