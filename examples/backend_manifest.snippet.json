{
  "nextcloud": {
    "slug": "nextcloud",
    "source_id": 507,
    "source_title": "Nextcloud (container)",
    "friendly_name": "Teste: Nextcloud",
    "image": "linuxserver/nextcloud:latest",
    "container_name": "nextcloud",
    "port": 80,
    "launch_url": "--kiosk http://kasm-wait:8080/wait?target=http%3A%2F%2Fnextcloud%3A80",
    "target_url": "http://nextcloud:80",
    "wait_url": "http://kasm-wait:8080/wait?target=http%3A%2F%2Fnextcloud%3A80",
    "env": [
      {
        "name": "PUID",
        "required": false,
        "default": "1000",
        "label": "PUID"
      },
      {
        "name": "PGID",
        "required": false,
        "default": "1000",
        "label": "PGID"
      },
      {
        "name": "TZ",
        "required": false,
        "default": "Etc/UTC",
        "label": "TZ"
      }
    ],
    "env_defaults": {
      "PUID": "1000",
      "PGID": "1000",
      "TZ": "Etc/UTC"
    },
    "required_env": [],
    "volumes": [
      {
        "container": "/config",
        "bind": "/srv/lsio/nextcloud/config",
        "readonly": false
      },
      {
        "container": "/data",
        "bind": "/srv/lsio/nextcloud/data",
        "readonly": false
      }
    ],
    "restart_policy": "unless-stopped",
    "privileged": false,
    "network_mode": "",
    "command": "",
    "hostname": "",
    "labels": [],
    "image_src": "nextcloud.png"
  },
